<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bulk Poster Sender</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --accent-color: #6366f1;
      --accent-hover: #4f46e5;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }
    .form-container {
      background-color: var(--card-bg);
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: 550px;
      border: 1px solid var(--border-color);
    }

    .logo-container {
      display: flex;
      justify-content: center;
      margin-bottom: 20px;
    }

    .gmail-logo {
      width: 64px;
      height: 64px;
    }

    .form-container h2 {
      margin-bottom: 8px;
      font-size: 24px;
      font-weight: 600;
      text-align: center;
      letter-spacing: -0.5px;
    }

    .form-container p {
      color: var(--text-muted);
      font-size: 14px;
      text-align: center;
      margin-bottom: 30px;
    }

    .form-group {
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 8px;
      color: var(--text-main);
    }

    input[type="text"],
    input[type="email"],
    textarea {
      background-color: #0f172a;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 12px 16px;
      color: var(--text-main);
      font-size: 15px;
      transition: all 0.3s ease;
      width: 100%;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    textarea:focus {
      outline: none;
      border-color: var(--accent-color);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }

    textarea {
      resize: vertical;
      min-height: 100px;
    }

    .file-input-wrapper {
      position: relative;
      border: 2px dashed var(--border-color);
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      background-color: #0f172a;
      cursor: pointer;
      transition: border-color 0.3s ease;
    }

    .file-input-wrapper:hover {
      border-color: var(--accent-color);
    }

    .file-input-wrapper input[type="file"] {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .file-input-wrapper p {
      margin: 0;
      font-size: 14px;
      color: var(--text-muted);
    }

    .file-input-wrapper p span {
      color: var(--accent-color);
      font-weight: 600;
    }

    input[type="submit"] {
      background-color: var(--accent-color);
      color: white;
      border: none;
      border-radius: 8px;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      transition: background-color 0.3s ease, transform 0.1s ease;
      margin-top: 10px;
    }

    input[type="submit"]:hover {
      background-color: var(--accent-hover);
    }

    input[type="submit"]:active {
      transform: scale(0.98);
    }

    ::placeholder {
      color: #475569;
    }
  </style>
</head>

<body>

  <div class="form-container">
    <div class="logo-container">
      <svg class="gmail-logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="#ea4335"/>
      </svg>
    </div>

    <h2>Bulk Poster Dispatch</h2>
    <p>Upload your design and send it to multiple clients simultaneously</p>

    <form action="/api/looking-poster" method="POST" enctype="multipart/form-data">
      
      <div class="form-group">
        <label>Poster Attachment</label>
        <div class="file-input-wrapper">
          <input type="file" name="attachment" id="file" required onchange="updateFileName()">
          <p id="file-label">Drag & drop or <span>browse</span> your poster file</p>
        </div>
      </div>

      <div class="form-group">
        <label for="email">Recipients (Gmail List)</label>
        <textarea name="email" id="email" placeholder="example1@gmail.com, example2@gmail.com, example3@gmail.com" required></textarea>
      </div>

      <div class="form-group">
        <label for="title">Email Title</label>
        <input type="text" name="title" id="title" placeholder="e.g., Your Custom Poster Design Inside!" required>
      </div>

      <div class="form-group">
        <label for="content">Message Content</label>
        <textarea name="content" id="content" placeholder="Write a nice message to your clients..." required></textarea>
      </div>

      <input type="submit" value="Send Bulk Poster">
    </form>
  </div>

  <script>
    function updateFileName() {
      const fileInput = document.getElementById('file');
      const fileLabel = document.getElementById('file-label');
      if (fileInput.files.length > 0) {
        fileLabel.innerHTML = `Selected file: <span style="color: #6366f1;">${fileInput.files[0].name}</span>`;
      }
    }
  </script>
  <script src="./exercise.js"></script>
</body>

</html>